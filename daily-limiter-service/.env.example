# Comma-separated list of Kafka broker addresses
KAFKA_BROKERS=localhost:9092

# Kafka client identifier (optional)
KAFKA_CLIENT_ID=daily-action-limiter

# Consumer group ID (optional)
KAFKA_GROUP_ID=daily-action-limiter-group

# Topic to consume from
KAFKA_TOPIC=my-topic

# Path to the file that persists per-key action timestamps (optional)
STATE_FILE_PATH=./limiter-state.json
